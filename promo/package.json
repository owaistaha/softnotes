{
  "name": "softnotes-promo",
  "version": "1.0.0",
  "description": "10-second vertical promo for SoftNotes (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/media": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "node --no-warnings scripts/make-audio.mjs",
    "render": "npm run audio && remotion render SoftNotesPromo out/softnotes-promo.mp4 --codec h264 --crf 15 --image-format=png --pixel-format yuv420p --color-space bt709 --audio-codec aac --audio-bitrate 256k",
    "stills": "node scripts/stills.mjs"
  }
}
